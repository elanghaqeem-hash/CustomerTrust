# Copy to hostinger.env, chmod 600, NEVER commit the resulting file.
# Use: openssl rand -hex 32 (for each separate secret). Hex is URI-safe.
TRAINLIVE_DOMAIN=trainlive.seraya.id
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
TRAINLIVE_APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
TRAINLIVE_JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_MIN_32_BYTES
# Configure a REAL company IdP with a verified MFA claim, not placeholders.
TRAINLIVE_OIDC_ISSUER=https://login.example.org
TRAINLIVE_OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
TRAINLIVE_OIDC_CLIENT_SECRET=
TRAINLIVE_OIDC_ALLOWED_EMAIL_DOMAINS=example.org
TRAINLIVE_OIDC_MFA_ACR=
