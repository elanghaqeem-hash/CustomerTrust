# Trusted maintenance only; never publish this image or its administrator DB URI.
FROM node:22-bookworm-slim
WORKDIR /workspace
COPY tools/trainlive/package*.json ./tools/trainlive/
RUN npm install --prefix tools/trainlive --omit=dev --no-audit --no-fund
COPY tools/trainlive/ ./tools/trainlive/
COPY seed/ ./seed/
USER node
ENTRYPOINT ["node"]
