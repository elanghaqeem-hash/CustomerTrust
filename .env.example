# TrainLive environment template. Copy to .env LOCALLY only; never commit real values.
# In Vercel, enter these as encrypted (Sensitive) environment variables.

# --- PostgreSQL --------------------------------------------------------------
# Local docker-compose superuser password (local only).
POSTGRES_PASSWORD=replace-with-local-secret
# Migration owner. Use the provider's DIRECT (non-pooled) endpoint. Operator/CI only, never in Vercel.
DATABASE_URL_ADMIN=postgresql://trainlive_owner:replace-with-local-secret@localhost:5432/trainlive
# Restricted runtime login (member of trainlive_app, NOT the owner). On Vercel use the POOLED endpoint.
DATABASE_URL_APP=
# Password used by `db-setup.mjs runtime-role` to create the runtime login (openssl rand -hex 32).
TRAINLIVE_APP_DB_PASSWORD=
# TLS: verify-full (default for non-local hosts) | require | disable (private network only).
TRAINLIVE_DB_SSL=
# Optional provider CA bundle (PEM, \n-escaped allowed) or a file path.
TRAINLIVE_DB_CA_CERT=
TRAINLIVE_DB_CA_CERT_FILE=
# Optional pool tuning (default 3 on Vercel, 10 elsewhere).
TRAINLIVE_DB_POOL_MAX=

# --- Sessions ----------------------------------------------------------------
# >= 32 bytes random (openssl rand -hex 32).
TRAINLIVE_JWT_SECRET=

# --- Staff SSO (OIDC + MFA) — see docs/STAFF-SSO.md ---------------------------
# Public HTTPS origin, no path. Callback = <origin>/api/auth/staff/callback
TRAINLIVE_APP_ORIGIN=
TRAINLIVE_OIDC_ISSUER=
TRAINLIVE_OIDC_CLIENT_ID=
TRAINLIVE_OIDC_CLIENT_SECRET=
# client_secret_post (default) | client_secret_basic
TRAINLIVE_OIDC_TOKEN_AUTH=
# Comma-separated approved staff email domains, e.g. banksulteng.co.id
TRAINLIVE_OIDC_ALLOWED_EMAIL_DOMAINS=
# Accepted `acr` values that prove MFA (used when the ID token has no amr MFA method).
TRAINLIVE_OIDC_MFA_ACR=
# acr_values to request on login (step-up), space/comma separated.
TRAINLIVE_OIDC_ACR_VALUES=
# true = request the amr claim via the OIDC `claims` parameter (needed for Google).
TRAINLIVE_OIDC_REQUEST_AMR=
